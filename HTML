<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="The Urban Plate - Experience delicious food, premium dining and unforgettable moments.">
    <title>The Urban Plate | Restaurant</title>

    <link rel="stylesheet" href="style.css">

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar">
            <a href="#" class="logo">THE <span>URBAN</span> PLATE.</a>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#offers">Offers</a></li>
                <li><a href="#reviews">Reviews</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <a href="#reservation" class="nav-btn">Book a Table</a>
        </nav>
    </header>


    <!-- HERO SECTION -->
    <section class="hero" id="home">
        <div class="hero-content">
            <p class="subtitle">WELCOME TO THE URBAN PLATE</p>

            <h1>Good Food.<br>
                Great Moments.<br>
                <span>Unforgettable Taste.</span>
            </h1>

            <p class="hero-description">
                Discover delicious flavors, fresh ingredients and
                unforgettable dining experiences.
            </p>

            <div class="hero-buttons">
                <a href="#menu" class="btn primary-btn">Explore Menu</a>
                <a href="#reservation" class="btn secondary-btn">Reserve a Table</a>
            </div>
        </div>
    </section>


    <!-- ABOUT SECTION -->
    <section class="about section" id="about">

        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=900" alt="Restaurant interior">
        </div>

        <div class="about-content">
            <p class="subtitle">OUR STORY</p>

            <h2>Where Every Meal<br>
                Becomes a <span>Memory.</span>
            </h2>

            <p>
                At The Urban Plate, we believe great food brings
                people together. Our chefs combine fresh ingredients,
                traditional flavors and modern cooking techniques
                to create an unforgettable dining experience.
            </p>

            <p>
                From casual lunches to special celebrations,
                every moment deserves something delicious.
            </p>

            <a href="#menu" class="btn primary-btn">Discover More</a>
        </div>

    </section>


    <!-- MENU SECTION -->
    <section class="menu section" id="menu">

        <div class="section-heading">
            <p class="subtitle">EXPLORE OUR MENU</p>
            <h2>Our Delicious <span>Menu</span></h2>
            <p>Fresh ingredients. Authentic flavors. Made with love.</p>
        </div>

        <div class="menu-grid">

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600" alt="Classic burger">
                <div class="menu-info">
                    <h3>Classic Burger</h3>
                    <p>Juicy grilled patty with fresh vegetables and sauce.</p>
                    <div class="price-row">
                        <span>₹249</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-157 pizza" alt="Pizza">
                <div class="menu-info">
                    <h3>Italian Pizza</h3>
                    <p>Freshly baked pizza topped with cheese and herbs.</p>
                    <div class="price-row">
                        <span>₹349</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600" alt="Healthy salad">
                <div class="menu-info">
                    <h3>Fresh Salad</h3>
                    <p>Healthy greens with fresh vegetables and dressing.</p>
                    <div class="price-row">
                        <span>₹199</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=600" alt="Grilled food">
                <div class="menu-info">
                    <h3>Grilled Special</h3>
                    <p>Perfectly grilled specialties with signature spices.</p>
                    <div class="price-row">
                        <span>₹399</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?w=600" alt="Dessert">
                <div class="menu-info">
                    <h3>Chocolate Dessert</h3>
                    <p>Rich chocolate dessert for a sweet ending.</p>
                    <div class="price-row">
                        <span>₹179</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

            <div class="menu-card">
                <img src="https://images.unsplash.com/photo-1544145945-f90425340c7e?w=600" alt="Fresh beverage">
                <div class="menu-info">
                    <h3>Fresh Mocktail</h3>
                    <p>Refreshing fruit-based drinks and cool flavors.</p>
                    <div class="price-row">
                        <span>₹149</span>
                        <a href="#reservation">Order Now</a>
                    </div>
                </div>
            </div>

        </div>
    </section>


    <!-- SPECIAL OFFERS -->
    <section class="offers section" id="offers">

        <div class="offer-content">
            <p class="subtitle">LIMITED TIME OFFER</p>

            <h2>Good Food Gets<br>
                <span>Even Better!</span>
            </h2>

            <p>
                Enjoy exclusive dining deals and delicious
                combinations made for sharing.
            </p>

            <div class="discount">25% OFF</div>

            <a href="#menu" class="btn primary-btn">Grab This Offer</a>
        </div>

        <div class="offer-image">
            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=900" alt="Special pizza offer">
        </div>

    </section>


    <!-- REVIEWS -->
    <section class="reviews section" id="reviews">

        <div class="section-heading">
            <p class="subtitle">CUSTOMER EXPERIENCES</p>
            <h2>What Our Customers <span>Say</span></h2>
        </div>

        <div class="review-grid">

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Amazing food, beautiful ambience and excellent service. Definitely coming back!"</p>
                <h3>Rahul Sharma</h3>
                <span>Regular Customer</span>
            </div>

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"One of the best dining experiences. Everything was fresh and delicious."</p>
                <h3>Priya Reddy</h3>
                <span>Food Lover</span>
            </div>

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Great atmosphere, friendly staff and amazing dishes. Highly recommended!"</p>
                <h3>Arjun Kumar</h3>
                <span>Happy Customer</span>
            </div>

        </div>
    </section>


    <!-- RESERVATION -->
    <section class="reservation section" id="reservation">

        <div class="section-heading">
            <p class="subtitle">MAKE A RESERVATION</p>
            <h2>Reserve Your <span>Table</span></h2>
            <p>We look forward to serving you.</p>
        </div>

        <form class="reservation-form" action="#" method="post">

            <input type="text" placeholder="Your Name" required>

            <input type="email" placeholder="Your Email" required>

            <input type="tel" placeholder="Phone Number" required>

            <input type="date" required>

            <input type="time" required>

            <select required>
                <option value="">Number of Guests</option>
                <option>1 Guest</option>
                <option>2 Guests</option>
                <option>3 Guests</option>
                <option>4 Guests</option>
                <option>5+ Guests</option>
            </select>

            <textarea placeholder="Special Requests"></textarea>

            <button type="submit" class="btn primary-btn">
                Reserve Your Table
            </button>

        </form>
    </section>


    <!-- CONTACT -->
    <section class="contact section" id="contact">

        <div class="section-heading">
            <p class="subtitle">GET IN TOUCH</p>
            <h2>Visit <span>Our Restaurant</span></h2>
        </div>

        <div class="contact-grid">

            <div class="contact-info">
                <h3>Contact Information</h3>

                <p>📍 Vijayawada, Andhra Pradesh, India</p>
                <p>📞 +91 98765 43210</p>
                <p>✉️ hello@theurbanplate.com</p>
                <p>🕒 Monday – Sunday: 11 AM – 11 PM</p>

                <div class="social-links">
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">YouTube</a>
                </div>
            </div>

            <div class="map">
                <iframe src="https://www.google.com/maps?q=Vijayawada&output=embed" width="100%" height="300" style="border:0;" loading="lazy" title="Restaurant location map">
                </iframe>
            </div>

        </div>

    </section>


    <!-- FOOTER -->
    <footer class="footer">

        <a href="#" class="logo">THE <span>URBAN</span> PLATE.</a>

        <p>Good food. Great moments. Unforgettable taste.</p>

        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#menu">Menu</a>
            <a href="#offers">Offers</a>
            <a href="#contact">Contact</a>
        </div>

        <p class="copyright">
            © 2026 The Urban Plate. All Rights Reserved.
        </p>

    </footer>

</body>

</html>
