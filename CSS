@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caveat:wght@400;700&family=Lobster&family=Monoton&family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Playfair+Display+SC:ital,wght@0,400;0,700;1,700&family=Playfair+Display:ital,wght@0,400;0,700;1,700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+Pro:ital,wght@0,400;0,700;1,700&family=Work+Sans:ital,wght@0,400;0,700;1,700&display=swap');

/* GLOBAL STYLES */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --gold: #d6a354;
    --dark: #151515;
    --light: #f8f5ef;
    --gray: #a7a7a7;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--dark);
    color: white;
    line-height: 1.7;
}

h1,
h2,
h3,
.logo {
    font-family: 'Playfair Display', serif;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

.section {
    padding: 100px 8%;
}

.subtitle {
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 3px;
    font-weight: 700;
    margin-bottom: 15px;
}

span {
    color: var(--gold);
}


/* NAVBAR */

header {
    background: #111;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    min-height: 85px;
    padding: 15px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: 700;
    letter-spacing: 1px;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    font-size: 14px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: var(--gold);
}

.nav-btn {
    background: var(--gold);
    color: #111;
    padding: 12px 22px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 13px;
    transition: 0.3s;
}

.nav-btn:hover {
    background: white;
}


/* BUTTONS */

.btn {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    transition: 0.3s;
    cursor: pointer;
    border: none;
}

.primary-btn {
    background: var(--gold);
    color: #111;
}

.primary-btn:hover {
    background: white;
    transform: translateY(-4px);
}

.secondary-btn {
    border: 1px solid white;
    color: white;
}

.secondary-btn:hover {
    background: white;
    color: #111;
}


/* HERO */

.hero {
    min-height: 90vh;
    background:
        linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.7)),
        url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1800') center/cover no-repeat;

    display: flex;
    align-items: center;
    padding: 80px 8%;
}

.hero-content {
    max-width: 750px;
    animation: fadeUp 1s ease;
}

.hero h1 {
    font-size: clamp(45px, 6vw, 76px);
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero-description {
    color: #ddd;
    max-width: 500px;
    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}


/* ABOUT */

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.about-image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 8px;
}

.about-content h2 {
    font-size: 43px;
    line-height: 1.3;
    margin-bottom: 25px;
}

.about-content p {
    color: var(--gray);
    margin-bottom: 20px;
}

.about-content .btn {
    margin-top: 15px;
}


/* SECTION HEADING */

.section-heading {
    text-align: center;
    margin-bottom: 55px;
}

.section-heading h2 {
    font-size: 42px;
    margin-bottom: 12px;
}

.section-heading p:last-child {
    color: var(--gray);
}


/* MENU */

.menu {
    background: #1d1d1d;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.menu-card {
    background: #262626;
    border-radius: 8px;
    overflow: hidden;
    transition: 0.3s;
}

.menu-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

.menu-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    transition: 0.4s;
}

.menu-card:hover img {
    transform: scale(1.05);
}

.menu-info {
    padding: 25px;
}

.menu-info h3 {
    font-size: 22px;
    margin-bottom: 10px;
}

.menu-info p {
    color: var(--gray);
    font-size: 14px;
    min-height: 50px;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
}

.price-row span {
    font-size: 21px;
    font-weight: 700;
}

.price-row a {
    color: var(--gold);
    font-size: 13px;
    font-weight: 700;
}

.price-row a:hover {
    color: white;
}


/* OFFERS */

.offers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    background: #24201a;
}

.offer-content h2 {
    font-size: 50px;
    line-height: 1.3;
    margin-bottom: 20px;
}

.offer-content p {
    color: var(--gray);
    margin-bottom: 20px;
}

.discount {
    color: var(--gold);
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 25px;
    font-family: 'Playfair Display', serif;
}

.offer-image img {
    width: 100%;
    height: 430px;
    object-fit: cover;
    border-radius: 8px;
}


/* REVIEWS */

.review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.review-card {
    background: #242424;
    padding: 35px;
    border-radius: 8px;
    transition: 0.3s;
}

.review-card:hover {
    transform: translateY(-8px);
}

.stars {
    color: var(--gold);
    font-size: 20px;
    margin-bottom: 20px;
}

.review-card p {
    color: #ccc;
    margin-bottom: 25px;
}

.review-card h3 {
    font-size: 19px;
}

.review-card span {
    font-size: 13px;
}


/* RESERVATION */

.reservation {
    background: #202020;
}

.reservation-form {
    max-width: 800px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.reservation-form input,
.reservation-form select,
.reservation-form textarea {
    width: 100%;
    padding: 16px;
    background: #2c2c2c;
    border: 1px solid #444;
    color: white;
    border-radius: 4px;
    outline: none;
    font-family: inherit;
}

.reservation-form input:focus,
.reservation-form select:focus,
.reservation-form textarea:focus {
    border-color: var(--gold);
}

.reservation-form textarea {
    grid-column: span 2;
    min-height: 110px;
    resize: vertical;
}

.reservation-form button {
    grid-column: span 2;
}


/* CONTACT */

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: center;
}

.contact-info h3 {
    font-size: 27px;
    margin-bottom: 25px;
}

.contact-info p {
    color: #ccc;
    margin-bottom: 20px;
}

.social-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 30px;
}

.social-links a {
    color: var(--gold);
    font-weight: 600;
}

.map iframe {
    border-radius: 8px;
}

.footer {
    background: #0c0c0c;
    text-align: center;
    padding: 55px 8% 25px;
}

.footer>p {
    color: var(--gray);
    margin: 15px 0;
}

.footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin: 30px 0;
}

.footer-links a:hover {
    color: var(--gold);
}

.copyright {
    border-top: 1px solid #333;
    padding-top: 25px;
    font-size: 13px;
}


/* ANIMATIONS */

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* TABLET RESPONSIVE */

@media (max-width: 992px) {

    .navbar {
        flex-wrap: wrap;
        gap: 20px;
    }

    .nav-links {
        gap: 15px;
    }

    .about,
    .offers {
        grid-template-columns: 1fr;
    }

    .menu-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .review-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* MOBILE RESPONSIVE */

@media (max-width: 650px) {

    .section {
        padding: 70px 6%;
    }

    .navbar {
        justify-content: center;
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px 18px;
    }

    .nav-links a {
        font-size: 12px;
    }

    .hero {
        min-height: 75vh;
        padding: 60px 6%;
    }

    .hero h1 {
        font-size: 43px;
    }

    .about-content h2,
    .section-heading h2 {
        font-size: 32px;
    }

    .about-image img {
        height: 330px;
    }

    .menu-grid,
    .review-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .offer-content h2 {
        font-size: 38px;
    }

    .offer-image img {
        height: 300px;
    }

    .reservation-form {
        grid-template-columns: 1fr;
    }

    .reservation-form textarea,
    .reservation-form button {
        grid-column: span 1;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-links {
        gap: 15px;
    }
}
